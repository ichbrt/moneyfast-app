# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/bulk_payments
# Or use separate variables:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bulk_payments
# DB_USER=username
# DB_PASSWORD=password

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# MTN MoMo Configuration
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=your_mtn_disbursement_subscription_key
MTN_API_USER=your_generated_api_user_uuid
MTN_API_KEY=your_generated_api_key
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CALLBACK_HOST=https://your-domain.com

# Airtel Money Configuration
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret

# Application Settings
MAX_TRANSACTION_AMOUNT=5000000
MIN_TRANSACTION_AMOUNT=1000
PAYOUT_BATCH_SIZE=50
RETRY_ATTEMPTS=3
MOCK_MODE=true
