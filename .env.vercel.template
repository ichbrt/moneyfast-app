# MoneyFast Uganda - Vercel Environment Variables Template
# Bu dosyayı Vercel Dashboard → Settings → Environment Variables kısmına kopyalayın

# ============================================
# ZORUNLU DEĞIŞKENLER (Minimum Çalışma İçin)
# ============================================

# JWT Secret Key - Güçlü bir key kullanın
JWT_SECRET=moneyfast-uganda-super-secret-key-2025-change-this

# Node Environment
NODE_ENV=production

# Server Port (Vercel otomatik ayarlar, ama belirtmek iyi)
PORT=3000

# Mock Mode - Demo için true, Production için false
# true = Gerçek API çağrıları yapmaz, test verileri kullanır
# false = Gerçek MTN/Airtel API'lerini kullanır
MOCK_MODE=true

# ============================================
# MTN MOMO CREDENTIALS (Opsiyonel - Sandbox)
# ============================================

# MTN Base URL - Sandbox veya Production
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
# Production için: https://momodeveloper.mtn.com

# MTN Subscription Key (MTN Developer Portal'dan alın)
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key_here

# MTN API User UUID (MTN Developer Portal'da oluşturun)
MTN_API_USER=your_mtn_api_user_uuid_here

# MTN API Key (MTN Developer Portal'da generate edin)
MTN_API_KEY=your_mtn_api_key_here

# MTN Target Environment
MTN_TARGET_ENVIRONMENT=sandbox
# Production için: production

# MTN Callback Host (Vercel URL'iniz)
MTN_CALLBACK_HOST=https://your-vercel-url.vercel.app
# Domain bağladıktan sonra: https://dslns.com

# ============================================
# AIRTEL MONEY CREDENTIALS (Opsiyonel - Sandbox)
# ============================================

# Airtel Base URL - Sandbox veya Production
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
# Production için: https://openapi.airtel.africa

# Airtel Client ID (Airtel Developer Portal'dan alın)
AIRTEL_CLIENT_ID=your_airtel_client_id_here

# Airtel Client Secret (Airtel Developer Portal'dan alın)
AIRTEL_CLIENT_SECRET=your_airtel_client_secret_here

# ============================================
# DATABASE CONFIGURATION (Opsiyonel - Production)
# ============================================

# PostgreSQL Connection String
# MOCK_MODE=true ise gerekli değil (SQLite kullanır)
# Production için PostgreSQL önerilir: Neon.tech, Supabase, Railway
# DATABASE_URL=postgresql://username:password@host:5432/database_name

# ============================================
# APPLICATION SETTINGS (Opsiyonel)
# ============================================

# Maximum transaction amount (UGX)
MAX_TRANSACTION_AMOUNT=5000000

# Minimum transaction amount (UGX)
MIN_TRANSACTION_AMOUNT=1000

# Payout batch size (kaç transaction aynı anda işlensin)
PAYOUT_BATCH_SIZE=50

# Retry attempts for failed transactions
RETRY_ATTEMPTS=3

# ============================================
# NOTLAR
# ============================================

# 1. DEMO MODE İLE BAŞLAYIN:
#    - MOCK_MODE=true yapın
#    - MTN/Airtel credentials'ları boş bırakabilirsiniz
#    - Database gerekmez (SQLite kullanır)
#
# 2. PRODUCTION'A GEÇİŞ:
#    - MOCK_MODE=false yapın
#    - MTN/Airtel production credentials ekleyin
#    - PostgreSQL database bağlayın (DATABASE_URL)
#    - JWT_SECRET'ı güçlü bir key ile değiştirin
#
# 3. GÜVENLİK:
#    - Bu dosyayı asla GitHub'a yüklemeyin (.gitignore'da)
#    - JWT_SECRET'ı production'da mutlaka değiştirin
#    - API credentials'ları güvenli saklayın
#
# 4. VERCEL'E EKLEME:
#    - Vercel Dashboard → Your Project → Settings → Environment Variables
#    - Her satırı ayrı ayrı ekleyin (Key = Value formatında)
#    - Yorumları (#) eklemeyin, sadece değişkenleri ekleyin
